# MongoDB connection string. Local dev only ever needs mongodb://localhost:27017
# with no credentials; production MUST point at an authenticated cluster (e.g.
# MongoDB Atlas) reachable only from the backend host's IP/VPC. Never reuse a
# local, unauthenticated connection string in production.
MONGO_URL=
DB_NAME=kharo
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate this (and re-issue all sessions) if it is ever exposed.
JWT_SECRET=
ADMIN_EMAIL=you@example.com
# Set a strong, unique password here; this seeds the one and only admin
# account on first startup (see seed_admin in server.py).
ADMIN_PASSWORD=
# Comma-separated list of exact frontend origins allowed to call this API
# with credentials, e.g. https://kharo.co.uk,https://www.kharo.co.uk
# Defaults to http://localhost:3000 if unset — deliberately fails closed
# rather than opening the API to every origin.
CORS_ORIGINS=http://localhost:3000
# Set to 1 only if this API sits behind a reverse proxy you control that
# overwrites (not appends to) any inbound X-Forwarded-For before adding its
# own hop. Leave unset/0 otherwise — see rate_limit() in server.py.
TRUST_PROXY_HEADERS=0


# ── Email (Resend). Add RESEND_API_KEY once kharo.co.uk is verified at resend.com
# and every registration gets a thank-you automatically. Without the key, sends
# are skipped quietly and nothing breaks.
RESEND_API_KEY=
# Legacy fallback used only if RESEND_API_KEY is unset. Safe to leave blank;
# remove once the Resend migration is confirmed complete.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Kharo
EMAIL_FROM_ADDRESS=hello@kharo.co.uk
CONTACT_EMAIL=hello@kharo.co.uk
# Inbox that receives new-registration/interest alert emails. Use a shared
# team inbox rather than a personal address once this repo is public.
ALERT_EMAIL=alerts@kharo.co.uk
# Must match the real production frontend origin exactly — it is embedded in
# password-reset links sent to users, so a wrong value sends people to a
# dead or wrong site.
PUBLIC_BASE_URL=https://kharo.co.uk
# Links used in the welcome emails (send_welcome in emailer.py). Leave blank
# pre-launch; the email templates degrade gracefully with a placeholder line
# when these are unset.
DRIVER_DOC_URL=
OPERATOR_DOC_URL=

# ── Social profiles. Correct these to your real handles; the footer icons and
# the email follow row read from here and stay hidden while a value is empty.
SOCIAL_INSTAGRAM=https://www.instagram.com/kharo.uk
SOCIAL_LINKEDIN=https://www.linkedin.com/company/kharo-uk
SOCIAL_FACEBOOK=https://www.facebook.com/kharo.uk
